    wakePlane
    {
        type            surfaces;
        libs            (sampling);
        writeControl    onEnd;
        interpolationScheme cellPoint;
        surfaceFormat   vtk;
        fields          (UMean UPrime2Mean turbulenceProperties:k turbulenceProperties:kMean);

        surfaces
        (
            zPlane
            {
                type              plane;
                planeType         pointAndNormal;
                pointAndNormalDict
                {
                    point   (0 0 0.001);
                    normal  (0 0 1);
                }
                bounds      (-1.2 -1.4 -0.01) (6.0 1.4 0.01);
                interpolate true;
            }
        );
    }

}


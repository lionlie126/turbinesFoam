FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      controlDict;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

application     pimpleFoam;

startFrom       latestTime;

startTime       0;

stopAt          endTime;

endTime         9;

deltaT          0.0003;

writeControl    runTime;

writeInterval   1;

writeFormat     binary;

writePrecision  12;

purgeWrite      2;

//writeCompression uncompressed;

timeFormat      general;

timePrecision   6;

runTimeModifiable false;

adjustTimeStep  false;

libs
(
    "libturbinesFoam.so"
);

functions
{
    #includeFunc CourantNo
    fieldAverage1
    {
        type            fieldAverage;
        libs            (fieldFunctionObjects);
        executeControl  timeStep;
        executeInterval 1;
        writeControl    writeTime;
        timeStart       2.5;
        restartOnRestart true;

        fields
        (
            U
            {
                mean        on;
                prime2Mean  on;
                base        time;
            }
        );
    }

    sgsFields
    {
        type            turbulenceFields;
        libs            (fieldFunctionObjects);
        executeControl  timeStep;
        executeInterval 1;
        writeControl    none;
        fields          (k nut);
    }
    fieldAverage2
    {
        type            fieldAverage;
        libs            (fieldFunctionObjects);
        executeControl  timeStep;
        executeInterval 1;
        writeControl    writeTime;
        timeStart       2.5;
        restartOnRestart true;

        fields
        (
            turbulenceProperties:k
            {
                mean        on;
                prime2Mean  off;
                base        time;
            }
        );
    }


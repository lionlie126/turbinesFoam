FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    location    "system";
    object      fvOptions;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

turbine
{
    type            axialFlowTurbineALSource;
    active          on;

    axialFlowTurbineALSourceCoeffs
    {
        fieldNames          (U);
        selectionMode       cellSet;
        cellSet             turbine;

        origin              (0 0 0);
        axis                (-1 0 0);
        verticalDirection   (0 0 1);
        freeStreamVelocity  (4 0 0);
        tipSpeedRatio       7.5;
        rotorRadius         0.6;
        tiltAngle           0;

        velEvalType         EVM;
        forceProjType       gaussianIsotropic;
        gaussianRadiusType  chordBasedGaussianRadius;

        dynamicStall
        {
            active          off;
            dynamicStallModel LeishmanBeddoes;
        }

        filteredLiftingLine
        {
            active              off;
            writeOutputFll      off;
            relaxationFactorLC  0.1;
            relaxationFactorIV  0.1;
        }

        endEffects
        {
            active          off;
            endEffectsModel Glauert;

            GlauertCoeffs
            {
                tipEffects  on;
                rootEffects on;
            }

            ShenCoeffs
            {
                c1          0.125;
                c2          21;
                tipEffects  on;
                rootEffects on;
            }
        }

        blades
        {
            blade1
            {
                writePerf          true;
                writeElementPerf   true;
                nElements          38;

                elementProfiles
                (
                    #include "elementProfiles"
                );

                elementData
                (
                    #include "elementData"
                );
            }

            blade2
            {
                $blade1;
                writePerf          false;
                writeElementPerf   false;
                azimuthalOffset    120.0;
            }

            blade3
            {
                $blade2;
                azimuthalOffset    240.0;
            }
        }

        profileData
        {
            #include "profileData"
        }
    }
}


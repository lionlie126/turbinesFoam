FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    location    "constant";
    object      epsilonSettings;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

gridBasedGaussianRadiusCoeffs
{
    bladeEpsilonFactor 2;
}

chordBasedGaussianRadiusCoeffs
{
    bladeEpsilonFactor 0.25;
}

chordThicknessBasedGaussianCoeffs
{
    bladeEpsilonFactorChord     0.85; //chordwise
    bladeEpsilonFactorThickness 0.85; //thickwise
}

